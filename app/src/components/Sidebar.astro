---
import DarkModeToggle from './DarkModeToggle';
import { getCollection } from 'astro:content';
import { DASHBOARD_NAV_ITEMS } from '@/constants/dashboard-nav';

interface Props {
  currentPath?: string;
}

const { currentPath: rawCurrentPath = '' } = Astro.props;

// `Astro.url.pathname` includes the deployment base (for example
// `/egg-n-bacon-housing/dashboard/map`), while the link hrefs below are built
// with it. Strip it once here so active-state and `aria-current` matching work
// at the root and under any configured base path.
const basePath = import.meta.env.BASE_URL;
const currentPath =
  rawCurrentPath.length > 0 && rawCurrentPath.startsWith(basePath)
    ? `/${rawCurrentPath.slice(basePath.length)}`
    : rawCurrentPath;

// Get all analytics docs dynamically
const allDocs = await getCollection('analytics');
const analyticsDocs = allDocs
  .filter(doc => doc.data.status !== 'draft')
  .map(doc => ({
    title: doc.data.title || doc.id,
    slug: doc.id.replace(/\.mdx$/, ''),
  }))
  .sort((a, b) => a.title.localeCompare(b.title));

function isActive(path: string, href: string): boolean {
  if (!path) return false;
  // Strip BASE_URL from href for comparison (path is base-stripped above).
  // A base without a trailing slash must not produce a doubled `//` path.
  const rawBase = import.meta.env.BASE_URL;
  const baseHref =
    rawBase !== "/" && href.startsWith(rawBase)
      ? "/" + href.slice(rawBase.length)
      : href.replace(rawBase, "/");
  const normalizedPath = path.replace(/\/+$/, '') || '/';

  if (baseHref.includes('/dashboard/')) {
    const normalizedHref = baseHref.replace(/\/$/, '') || '/dashboard';
    return normalizedPath === normalizedHref;
  }
  // Prefix match for analytics/catalog sections, tolerant of a missing
  // trailing slash on either side (`trailingSlash: "ignore"`).
  const sectionHref = baseHref.replace(/\/+$/, '') || '/';
  return normalizedPath === sectionHref || normalizedPath.startsWith(`${sectionHref}/`);
}

/**
 * `isActive` also matches section roots: `analytics/`, `catalog/` and the
 * dashboard href `/dashboard` all prefix-match their child pages, so more than
 * one link can carry the active visual treatment. Only the page's own
 * destination may carry `aria-current="page"`, so section roots pass
 * `exactOnly = true` while deeper destinations keep the prefix rule (a dataset
 * page under `/catalog/<layer>/…` still belongs to its layer link).
 */
function isCurrentPage(path: string, href: string, exactOnly = false): boolean {
  if (!isActive(path, href)) return false;
  if (!exactOnly) return true;
  const baseHref = href.replace(import.meta.env.BASE_URL, '/').replace(/\/+$/, '') || '/';
  const normalizedPath = path.replace(/\/+$/, '') || '/';
  return normalizedPath === baseHref;
}
---

<!-- Mobile top bar -->
<header class="fixed top-0 left-0 right-0 h-14 bg-card border-b border-border flex items-center justify-between px-4 z-50 lg:hidden">
  <button
    id="mobile-menu-toggle"
    class="p-2 -ml-2 rounded-md text-muted-foreground hover:text-foreground hover:bg-accent transition-colors"
    aria-label="Open navigation menu"
    aria-expanded="false"
  >
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
    </svg>
  </button>
  <a href={import.meta.env.BASE_URL} class="font-bold text-foreground text-sm">
    Egg n Bacon Housing
  </a>
  <div class="w-10">
    <DarkModeToggle client:load />
  </div>
</header>

<!-- Mobile backdrop -->
<div
  id="mobile-backdrop"
  class="fixed inset-0 bg-black/50 z-40 lg:hidden hidden"
  aria-hidden="true"
></div>

<!-- Sidebar (desktop: always visible, mobile: slide-out drawer) -->
<aside
  id="sidebar-drawer"
  class="w-64 bg-card border-r border-border fixed inset-y-0 left-0 overflow-y-auto z-50 transition-transform duration-300 ease-in-out -translate-x-full lg:translate-x-0"
  role="navigation"
  aria-label="Main navigation"
>
  <div class="p-6 flex items-center justify-between">
    <a href={import.meta.env.BASE_URL} class="block hover:opacity-80 transition-opacity">
      <h2 class="text-xl font-bold text-foreground mb-2">Egg n Bacon Housing</h2>
      <p class="text-sm text-muted-foreground">Analytics Dashboard</p>
    </a>
    <button
      id="mobile-menu-close"
      class="p-2 rounded-md text-muted-foreground hover:text-foreground hover:bg-accent transition-colors lg:hidden"
      aria-label="Close navigation menu"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <nav class="px-4 pb-4">
    <div class="mb-4 hidden lg:block">
      <DarkModeToggle client:load />
    </div>

    <!-- Dashboard Section -->
    <div>
      <div class="px-3 mb-3 flex items-center gap-2">
        <div class="h-4 w-0.5 bg-primary rounded-full"></div>
        <span class="text-xs font-bold text-foreground uppercase tracking-wider">
          Dashboard
        </span>
      </div>
      <div class="border-t border-border my-3"></div>
      <ul class="space-y-1">
        {
          DASHBOARD_NAV_ITEMS.map((item) => {
            const href = `${import.meta.env.BASE_URL}${item.path}`;

            return (
              <li>
                <a
                  href={href}
                  aria-current={isCurrentPage(currentPath, href, true) ? "page" : undefined}
                  class:list={[
                    "block rounded-lg px-3 py-2 transition-colors",
                    isActive(currentPath, href)
                      ? "bg-accent/50 border-l-2 border-primary text-foreground"
                      : "text-muted-foreground hover:bg-accent hover:text-accent-foreground"
                  ]}
                >
                  <span class="block text-sm font-medium">{item.label}</span>
                  <span class="mt-1 block text-xs text-muted-foreground">{item.description}</span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>

    <!-- Personas Section -->
    <div class="mt-6">
      <div class="px-3 mb-3 flex items-center gap-2">
        <div class="h-4 w-0.5 bg-primary rounded-full"></div>
        <span class="text-xs font-bold text-foreground uppercase tracking-wider">
          Personas
        </span>
      </div>
      <div class="border-t border-border my-3"></div>
      <ul class="space-y-1">
        <li>
          <a
            href={`${import.meta.env.BASE_URL}analytics/personas/first-time-buyer`}
            aria-current={
              isCurrentPage(currentPath, `${import.meta.env.BASE_URL}analytics/personas/first-time-buyer`)
                ? "page"
                : undefined
            }
            class:list={[
              "flex items-center gap-2 px-3 py-2 rounded-md text-sm font-medium transition-colors",
              isActive(currentPath, `${import.meta.env.BASE_URL}analytics/personas/first-time-buyer`)
                ? "text-foreground bg-accent/50 border-l-2 border-primary"
                : "text-muted-foreground hover:text-foreground hover:bg-accent"
            ]}
          >
            🏠
            <span>First-Time Buyer</span>
          </a>
        </li>
        <li>
          <a
            href={`${import.meta.env.BASE_URL}analytics/personas/investor`}
            aria-current={
              isCurrentPage(currentPath, `${import.meta.env.BASE_URL}analytics/personas/investor`)
                ? "page"
                : undefined
            }
            class:list={[
              "flex items-center gap-2 px-3 py-2 rounded-md text-sm font-medium transition-colors",
              isActive(currentPath, `${import.meta.env.BASE_URL}analytics/personas/investor`)
                ? "text-foreground bg-accent/50 border-l-2 border-primary"
                : "text-muted-foreground hover:text-foreground hover:bg-accent"
            ]}
          >
            💼
            <span>Investor</span>
          </a>
        </li>
        <li>
          <a
            href={`${import.meta.env.BASE_URL}analytics/personas/upgrader`}
            aria-current={
              isCurrentPage(currentPath, `${import.meta.env.BASE_URL}analytics/personas/upgrader`)
                ? "page"
                : undefined
            }
            class:list={[
              "flex items-center gap-2 px-3 py-2 rounded-md text-sm font-medium transition-colors",
              isActive(currentPath, `${import.meta.env.BASE_URL}analytics/personas/upgrader`)
                ? "text-foreground bg-accent/50 border-l-2 border-primary"
                : "text-muted-foreground hover:text-foreground hover:bg-accent"
            ]}
          >
            ⬆️
            <span>Upgrader</span>
          </a>
        </li>
      </ul>
    </div>

    <!-- Analytics Section -->
    <div class="mt-6">
      <div class="px-3 mb-3 flex items-center gap-2">
        <div class="h-4 w-0.5 bg-primary rounded-full"></div>
        <span class="text-xs font-bold text-foreground uppercase tracking-wider">
          Analytics
        </span>
      </div>
      <div class="border-t border-border my-3"></div>
      <ul class="space-y-1">
        <li>
          <a
            href={`${import.meta.env.BASE_URL}analytics/`}
            aria-current={
              isCurrentPage(currentPath, `${import.meta.env.BASE_URL}analytics/`, true) ? "page" : undefined
            }
            class:list={[
              "block px-3 py-2 rounded-md text-sm font-medium transition-colors",
              isActive(currentPath, `${import.meta.env.BASE_URL}analytics/`)
                ? "text-foreground bg-accent/50 border-l-2 border-primary"
                : "text-muted-foreground hover:bg-accent hover:text-accent-foreground"
            ]}
          >
            Analytics Index
          </a>
        </li>
        {
          analyticsDocs.map((doc) => (
            <li>
              <a
                href={`${import.meta.env.BASE_URL}analytics/${doc.slug}`}
                aria-current={
                  isCurrentPage(currentPath, `${import.meta.env.BASE_URL}analytics/${doc.slug}`)
                    ? "page"
                    : undefined
                }
                class:list={[
                  "block px-3 py-2 rounded-md text-sm font-medium transition-colors",
                  isActive(currentPath, `${import.meta.env.BASE_URL}analytics/${doc.slug}`)
                    ? "text-foreground bg-accent/50 border-l-2 border-primary"
                    : "text-muted-foreground hover:bg-accent hover:text-accent-foreground"
                ]}
              >
                {doc.title}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Data Catalog Section -->
    <div class="mt-6">
      <div class="px-3 mb-3 flex items-center gap-2">
        <div class="h-4 w-0.5 bg-primary rounded-full"></div>
        <span class="text-xs font-bold text-foreground uppercase tracking-wider">
          Data Catalog
        </span>
      </div>
      <div class="border-t border-border my-3"></div>
      <ul class="space-y-1">
        <li>
          <a
            href={`${import.meta.env.BASE_URL}catalog/`}
            aria-current={
              isCurrentPage(currentPath, `${import.meta.env.BASE_URL}catalog/`, true) ? "page" : undefined
            }
            class:list={[
              "block px-3 py-2 rounded-md text-sm font-medium transition-colors",
              isActive(currentPath, `${import.meta.env.BASE_URL}catalog/`)
                ? "text-foreground bg-accent/50 border-l-2 border-primary"
                : "text-muted-foreground hover:bg-accent hover:text-accent-foreground"
            ]}
          >
            Overview
          </a>
        </li>
        {
          ["bronze", "silver", "gold", "platinum"].map((layer) => (
            <li>
              <a
                href={`${import.meta.env.BASE_URL}catalog/${layer}`}
                aria-current={
                  isCurrentPage(currentPath, `${import.meta.env.BASE_URL}catalog/${layer}`) ? "page" : undefined
                }
                class:list={[
                  "block px-3 py-2 rounded-md text-sm font-medium transition-colors",
                  isActive(currentPath, `${import.meta.env.BASE_URL}catalog/${layer}`)
                    ? "text-foreground bg-accent/50 border-l-2 border-primary"
                    : "text-muted-foreground hover:bg-accent hover:text-accent-foreground"
                ]}
              >
                {layer.charAt(0).toUpperCase() + layer.slice(1)}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>
</aside>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const close = document.getElementById('mobile-menu-close');
  const backdrop = document.getElementById('mobile-backdrop');
  const drawer = document.getElementById('sidebar-drawer');

  // From `lg` up the drawer is permanently visible and must stay reachable.
  // Below `lg` it is a slide-out that is inert (and therefore not tabbable)
  // whenever it is closed.
  const desktopQuery = window.matchMedia('(min-width: 1024px)');
  const FOCUSABLE =
    'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])';

  let isOpen = false;
  let lastFocused: HTMLElement | null = null;

  function focusableItems(): HTMLElement[] {
    if (!drawer) return [];
    return Array.from(drawer.querySelectorAll<HTMLElement>(FOCUSABLE)).filter(
      (el) => el.offsetParent !== null,
    );
  }

  function setDrawerInert(shouldBeInert: boolean) {
    if (!drawer) return;
    if (shouldBeInert) drawer.setAttribute('inert', '');
    else drawer.removeAttribute('inert');
  }

  // While the drawer covers the page, the covered content stays out of the
  // accessibility tree as well as out of the tab order.
  function setBackgroundInert(shouldBeInert: boolean) {
    const container = drawer?.parentElement;
    if (!container) return;
    for (const sibling of Array.from(container.children)) {
      if (sibling === drawer) continue;
      // The backdrop is `aria-hidden` already and must stay clickable, since
      // click-outside-to-close is one of the documented ways out of the drawer.
      if (sibling.id === 'mobile-backdrop') continue;
      if (shouldBeInert) sibling.setAttribute('inert', '');
      else sibling.removeAttribute('inert');
    }
  }

  function openDrawer() {
    if (!drawer || isOpen) return;
    lastFocused = document.activeElement instanceof HTMLElement ? document.activeElement : null;
    isOpen = true;
    setDrawerInert(false);
    drawer.classList.remove('-translate-x-full');
    drawer.classList.add('translate-x-0');
    backdrop?.classList.remove('hidden');
    toggle?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    setBackgroundInert(true);
    // Start the focus trap inside the drawer.
    close?.focus();
  }

  function closeDrawer(restoreFocus = true) {
    if (!drawer) return;
    const wasOpen = isOpen;
    isOpen = false;
    drawer.classList.add('-translate-x-full');
    drawer.classList.remove('translate-x-0');
    backdrop?.classList.add('hidden');
    toggle?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    setBackgroundInert(false);
    setDrawerInert(!desktopQuery.matches);
    if (restoreFocus && wasOpen) {
      // `document.body` is not focusable; fall back to the toggle so closing
      // never drops the keyboard user at the top of the document.
      const target =
        lastFocused && lastFocused !== document.body ? lastFocused : toggle;
      target?.focus();
    }
    lastFocused = null;
  }

  function syncDrawerState() {
    if (desktopQuery.matches) {
      // Full silent close: crossing the breakpoint must not leave the backdrop,
      // the translated drawer or a stale aria-expanded behind.
      closeDrawer(false);
      setDrawerInert(false);
      return;
    }
    setDrawerInert(!isOpen);
  }

  function trapFocus(event: KeyboardEvent) {
    if (!isOpen || !drawer) return;
    const items = focusableItems();
    const first = items[0];
    const last = items[items.length - 1];
    if (!first || !last) return;

    const active = document.activeElement;
    const inside = drawer.contains(active);

    if (event.shiftKey) {
      if (!inside || active === first) {
        event.preventDefault();
        last.focus();
      }
      return;
    }
    if (!inside || active === last) {
      event.preventDefault();
      first.focus();
    }
  }

  toggle?.addEventListener('click', () => {
    if (isOpen) closeDrawer();
    else openDrawer();
  });
  close?.addEventListener('click', () => closeDrawer());
  backdrop?.addEventListener('click', () => closeDrawer());

  document.addEventListener('keydown', (event) => {
    if (!isOpen) return;
    if (event.key === 'Escape') {
      event.preventDefault();
      closeDrawer();
      return;
    }
    if (event.key === 'Tab') trapFocus(event);
  });

  desktopQuery.addEventListener('change', syncDrawerState);

  // Apply the closed-drawer inert state on load (mobile only).
  syncDrawerState();
</script>

<style>
  aside {
    scrollbar-width: thin;
    scrollbar-color: hsl(var(--muted)) transparent;
  }

  aside::-webkit-scrollbar {
    width: 6px;
  }

  aside::-webkit-scrollbar-track {
    background: transparent;
  }

  aside::-webkit-scrollbar-thumb {
    background-color: hsl(var(--muted));
    border-radius: 3px;
  }
</style>
