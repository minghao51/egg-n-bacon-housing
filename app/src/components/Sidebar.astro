---
/**
 * The application shell sidebar.
 *
 * It is a **per-section menu**, not a flat index of the whole site: the four
 * primary destinations live in the fixed header (`PrimaryNav.astro`) at `lg`
 * and up and at the top of the mobile drawer, and this sidebar lists only what
 * belongs to the section the reader is in.
 *
 * Accessibility is load-bearing here and was audited: the mobile drawer is a
 * real modal surface (focus trap, Escape, backdrop click, focus restore,
 * `inert` when closed), and `aria-current` / active state come from the single
 * matching implementation in `shell/nav-match.ts`.
 */
import PrimaryNav from './shell/PrimaryNav.astro';
import ResearchSubNav from './shell/ResearchSubNav.astro';
import { isActive, isCurrentPage, isResearchPath, stripBase } from './shell/nav-match';
import { RESEARCH_SUBNAV } from './shell/destinations';
import { DASHBOARD_NAV_ITEMS } from '@/constants/dashboard-nav';

interface Props {
  currentPath?: string;
}

const { currentPath: rawCurrentPath = '' } = Astro.props;

// `Astro.url.pathname` includes the deployment base (for example
// `/egg-n-bacon-housing/dashboard/map`), while the link hrefs below are built
// with it. Strip it once here so active-state and `aria-current` matching work
// at the root and under any configured base path.
const basePath = import.meta.env.BASE_URL;
const currentPath = stripBase(rawCurrentPath || Astro.url.pathname, basePath);

const dashboardItems = DASHBOARD_NAV_ITEMS.map((item) => {
  const href = `${basePath}${item.path}`;
  return {
    ...item,
    href,
    active: isActive(currentPath, href, basePath),
    current: isCurrentPage(currentPath, href, basePath, true),
  };
});

const catalogItems = [
  { key: 'overview', label: 'Overview', path: 'catalog/', exact: true },
  { key: 'bronze', label: 'Bronze', path: 'catalog/bronze', exact: false },
  { key: 'silver', label: 'Silver', path: 'catalog/silver', exact: false },
  { key: 'gold', label: 'Gold', path: 'catalog/gold', exact: false },
  { key: 'platinum', label: 'Platinum', path: 'catalog/platinum', exact: false },
].map((item) => {
  const href = `${basePath}${item.path}`;
  return {
    ...item,
    href,
    active: isActive(currentPath, href, basePath),
    current: isCurrentPage(currentPath, href, basePath, item.exact),
  };
});

// Which section menu this page belongs to. Everything else (Explore, an area
// fieldnote, a bare route) has no section items of its own; the header and the
// drawer still carry the four destinations, so nothing is unreachable.
const showDashboardSection =
  currentPath === '/' || currentPath === '/dashboard' || currentPath.startsWith('/dashboard/');
const showResearchSection = isResearchPath(currentPath);
const showCatalogSection =
  currentPath === '/catalog' || currentPath.startsWith('/catalog/');

// A page carries at most one `aria-current="page"`. When the section menu
// below already marks a link as the current page, the primary destination
// steps down to `aria-current="location"` (see `destinationAriaCurrent`).
const sectionHasCurrentLink =
  (showDashboardSection && dashboardItems.some((item) => item.current)) ||
  (showResearchSection &&
    RESEARCH_SUBNAV.some((item) =>
      isCurrentPage(currentPath, `${basePath}${item.href}`, basePath),
    )) ||
  (showCatalogSection && catalogItems.some((item) => item.current));
---

<!-- Top bar: brand + hamburger below `lg`, the four destinations from `lg` up. -->
<header
  class="fixed top-0 left-0 lg:left-64 right-0 h-14 bg-card border-b border-border z-50"
>
  <div class="flex h-full items-center justify-between px-4 lg:hidden">
    <button
      id="mobile-menu-toggle"
      class="p-2 -ml-2 rounded-md text-muted-foreground hover:text-foreground hover:bg-accent transition-colors"
      aria-label="Open navigation menu"
      aria-expanded="false"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
    <a href={basePath} class="font-bold text-foreground text-sm">
      Egg n Bacon Housing
    </a>
    {/* Balances the hamburger above so the brand stays centred: the right-hand
        slot used to hold the dark-mode toggle and the site is light-only now. */}
    <div class="w-10" aria-hidden="true"></div>
  </div>
  <PrimaryNav
    currentPath={currentPath}
    variant="bar"
    sectionHasCurrentLink={sectionHasCurrentLink}
  />
</header>

<!-- Mobile backdrop -->
<div
  id="mobile-backdrop"
  class="fixed inset-0 bg-black/50 z-40 lg:hidden hidden"
  aria-hidden="true"
></div>

<!-- Sidebar (desktop: always visible, mobile: slide-out drawer) -->
<aside
  id="sidebar-drawer"
  class="w-64 bg-card border-r border-border fixed inset-y-0 left-0 overflow-y-auto z-50 transition-transform duration-300 ease-in-out -translate-x-full lg:translate-x-0"
  role="navigation"
  aria-label="Main navigation"
>
  <div class="p-6 flex items-center justify-between">
    <a href={basePath} class="block hover:opacity-80 transition-opacity">
      <h2 class="text-xl font-bold text-foreground mb-2">Egg n Bacon Housing</h2>
      <p class="text-sm text-muted-foreground">Analytics Dashboard</p>
    </a>
    <button
      id="mobile-menu-close"
      class="p-2 rounded-md text-muted-foreground hover:text-foreground hover:bg-accent transition-colors lg:hidden"
      aria-label="Close navigation menu"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <nav class="px-4 pb-4">
    <!-- Global navigation for touch: from `lg` up it lives in the header. -->
    <PrimaryNav
      currentPath={currentPath}
      variant="drawer"
      sectionHasCurrentLink={sectionHasCurrentLink}
    />

    {
      showDashboardSection && (
        <div class="mt-6">
          <div class="px-3 mb-3 flex items-center gap-2">
            <div class="h-4 w-0.5 bg-primary rounded-full" />
            <span class="text-xs font-bold text-foreground uppercase tracking-wider">
              Dashboard
            </span>
          </div>
          <div class="border-t border-border my-3" />
          <ul class="space-y-1">
            {dashboardItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={item.current ? 'page' : undefined}
                  class:list={[
                    'block rounded-lg px-3 py-2 transition-colors',
                    item.active
                      ? 'bg-accent/50 border-l-2 border-primary text-foreground'
                      : 'text-muted-foreground hover:bg-accent hover:text-accent-foreground',
                  ]}
                >
                  <span class="block text-sm font-medium">{item.label}</span>
                  <span class="mt-1 block text-xs text-muted-foreground">
                    {item.description}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    {
      showResearchSection && (
        <div class="mt-6">
          <ResearchSubNav currentPath={currentPath} />
        </div>
      )
    }

    {
      showCatalogSection && (
        <div class="mt-6">
          <div class="px-3 mb-3 flex items-center gap-2">
            <div class="h-4 w-0.5 bg-primary rounded-full" />
            <span class="text-xs font-bold text-foreground uppercase tracking-wider">
              Data Catalog
            </span>
          </div>
          <div class="border-t border-border my-3" />
          <ul class="space-y-1">
            {catalogItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={item.current ? 'page' : undefined}
                  class:list={[
                    'block px-3 py-2 rounded-md text-sm font-medium transition-colors',
                    item.active
                      ? 'text-foreground bg-accent/50 border-l-2 border-primary'
                      : 'text-muted-foreground hover:bg-accent hover:text-accent-foreground',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </nav>
</aside>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const close = document.getElementById('mobile-menu-close');
  const backdrop = document.getElementById('mobile-backdrop');
  const drawer = document.getElementById('sidebar-drawer');

  // From `lg` up the drawer is permanently visible and must stay reachable.
  // Below `lg` it is a slide-out that is inert (and therefore not tabbable)
  // whenever it is closed.
  const desktopQuery = window.matchMedia('(min-width: 1024px)');
  const FOCUSABLE =
    'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])';

  let isOpen = false;
  let lastFocused: HTMLElement | null = null;

  function focusableItems(): HTMLElement[] {
    if (!drawer) return [];
    return Array.from(drawer.querySelectorAll<HTMLElement>(FOCUSABLE)).filter(
      (el) => el.offsetParent !== null,
    );
  }

  function setDrawerInert(shouldBeInert: boolean) {
    if (!drawer) return;
    if (shouldBeInert) drawer.setAttribute('inert', '');
    else drawer.removeAttribute('inert');
  }

  // While the drawer covers the page, the covered content stays out of the
  // accessibility tree as well as out of the tab order.
  function setBackgroundInert(shouldBeInert: boolean) {
    const container = drawer?.parentElement;
    if (!container) return;
    for (const sibling of Array.from(container.children)) {
      if (sibling === drawer) continue;
      // The backdrop is `aria-hidden` already and must stay clickable, since
      // click-outside-to-close is one of the documented ways out of the drawer.
      if (sibling.id === 'mobile-backdrop') continue;
      if (shouldBeInert) sibling.setAttribute('inert', '');
      else sibling.removeAttribute('inert');
    }
  }

  function openDrawer() {
    if (!drawer || isOpen) return;
    lastFocused = document.activeElement instanceof HTMLElement ? document.activeElement : null;
    isOpen = true;
    setDrawerInert(false);
    drawer.classList.remove('-translate-x-full');
    drawer.classList.add('translate-x-0');
    backdrop?.classList.remove('hidden');
    toggle?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    setBackgroundInert(true);
    // Start the focus trap inside the drawer.
    close?.focus();
  }

  function closeDrawer(restoreFocus = true) {
    if (!drawer) return;
    const wasOpen = isOpen;
    isOpen = false;
    drawer.classList.add('-translate-x-full');
    drawer.classList.remove('translate-x-0');
    backdrop?.classList.add('hidden');
    toggle?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    setBackgroundInert(false);
    setDrawerInert(!desktopQuery.matches);
    if (restoreFocus && wasOpen) {
      // `document.body` is not focusable; fall back to the toggle so closing
      // never drops the keyboard user at the top of the document.
      const target =
        lastFocused && lastFocused !== document.body ? lastFocused : toggle;
      target?.focus();
    }
    lastFocused = null;
  }

  function syncDrawerState() {
    if (desktopQuery.matches) {
      // Full silent close: crossing the breakpoint must not leave the backdrop,
      // the translated drawer or a stale aria-expanded behind.
      closeDrawer(false);
      setDrawerInert(false);
      return;
    }
    setDrawerInert(!isOpen);
  }

  function trapFocus(event: KeyboardEvent) {
    if (!isOpen || !drawer) return;
    const items = focusableItems();
    const first = items[0];
    const last = items[items.length - 1];
    if (!first || !last) return;

    const active = document.activeElement;
    const inside = drawer.contains(active);

    if (event.shiftKey) {
      if (!inside || active === first) {
        event.preventDefault();
        last.focus();
      }
      return;
    }
    if (!inside || active === last) {
      event.preventDefault();
      first.focus();
    }
  }

  toggle?.addEventListener('click', () => {
    if (isOpen) closeDrawer();
    else openDrawer();
  });
  close?.addEventListener('click', () => closeDrawer());
  backdrop?.addEventListener('click', () => closeDrawer());

  document.addEventListener('keydown', (event) => {
    if (!isOpen) return;
    if (event.key === 'Escape') {
      event.preventDefault();
      closeDrawer();
      return;
    }
    if (event.key === 'Tab') trapFocus(event);
  });

  desktopQuery.addEventListener('change', syncDrawerState);

  // Apply the closed-drawer inert state on load (mobile only).
  syncDrawerState();
</script>

<style>
  aside {
    scrollbar-width: thin;
    scrollbar-color: hsl(var(--muted)) transparent;
  }

  aside::-webkit-scrollbar {
    width: 6px;
  }

  aside::-webkit-scrollbar-track {
    background: transparent;
  }

  aside::-webkit-scrollbar-thumb {
    background-color: hsl(var(--muted));
    border-radius: 3px;
  }
</style>
