---
/**
 * Shared shell for the segment workspace.
 *
 * `/research/segments` is the research destination; `/dashboard/segments` is
 * the compatibility wrapper that renders the same island under a legacy path.
 * The island reads the address bar before its first commit, so every query ID
 * (`persona`, `tab`, `segment`, `segments`, `area`) survives both entry points.
 */
import Layout from '@/layouts/Layout.astro';
import Sidebar from '@/components/Sidebar.astro';
import SegmentsDashboard from '@/components/dashboard/segments/SegmentsDashboard';
import { DATA_URLS } from '@/constants/data-urls';
// Leaflet styles are owned by the page: the island imports the map lazily and no
// longer reaches for the stylesheet itself.
import 'leaflet/dist/leaflet.css';

interface Props {
  title: string;
  description: string;
  headline: string;
  intro: string;
  legacyNote?: string;
}

const { title, description, headline, intro, legacyNote } = Astro.props;
const segmentsUrl = DATA_URLS.segments;
// Resolved once here (the Astro-native place for `import.meta.env`) and passed
// to the island, so the workspace has one base path and one asset URL.
const baseUrl = import.meta.env.BASE_URL;
---

<Layout title={title} description={description}>
  <Sidebar currentPath={Astro.url.pathname} />

  <main id="main-content" tabindex="-1" class="flex-1 pt-14 lg:pt-0 ml-0 lg:ml-64 transition-all duration-300">
    <div class="mx-auto w-full max-w-[1320px] px-4 py-8 sm:px-8">
      <header class="max-w-3xl">
        <p class="text-xs font-bold uppercase tracking-[1.6px] text-[hsl(var(--rust))]">
          Research / Segments
        </p>
        <h1 class="mt-3 text-4xl font-bold text-foreground sm:text-5xl">{headline}</h1>
        <p class="mt-4 text-lg text-muted-foreground">{intro}</p>
        <p class="mt-4 inline-block rounded-sm bg-[hsl(var(--secondary))] px-2 py-1 text-xs font-bold text-foreground">
          Stored research archive &middot; not a 2025 transaction view
        </p>
      </header>

      {
        legacyNote && (
          <p class="mt-4 max-w-3xl rounded-lg border border-border bg-muted/20 px-4 py-3 text-sm text-muted-foreground">
            {legacyNote}
          </p>
        )
      }

      <noscript>
        <div class="mt-6 rounded-lg border border-border bg-card p-5 text-sm text-foreground">
          <p class="font-bold">This workspace needs JavaScript.</p>
          <p class="mt-2 text-muted-foreground">
            Reading the selected persona, tab, segment, comparison set and area
            from the address bar, and keeping them there as you change them, is
            done in the browser. The six stored segments are published in
            <code class="font-mono">segments_enhanced.json.gz</code>; the
            observed transaction figures behind the comparison links are in
            <code class="font-mono">map_metrics.json.gz</code> and
            <code class="font-mono">dashboard_overview.json.gz</code>. Both are
            documented in the data catalogue.
          </p>
          <p class="mt-2 text-muted-foreground">
            These are stored research averages, not annual medians, and the
            segment archive is not part of the dashboard release manifest.
          </p>
        </div>
      </noscript>

      <div class="mt-8" data-segments-asset={segmentsUrl}>
        <SegmentsDashboard client:only="react" baseUrl={baseUrl} />
      </div>
    </div>
  </main>
</Layout>
