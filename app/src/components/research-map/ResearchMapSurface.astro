---
/**
 * Shared shell for the research map.
 *
 * `/research/map` is the research destination; `/dashboard/map` is the
 * compatibility wrapper. Both render the same island, so the five legacy query
 * groups (`metric`, `timeBasis`, `propertyType`, `area`, `layers`) and all nine
 * layer IDs survive on either URL.
 *
 * The archive generation date is read here at build time from the published
 * extract, so the page labels its vintage without trusting a client clock.
 */
import { readFileSync } from "node:fs";
import { resolve } from "node:path";
import { gunzipSync } from "node:zlib";

import Layout from "@/layouts/Layout.astro";
import Sidebar from "@/components/Sidebar.astro";
import PriceMap from "@/components/dashboard/PriceMap";

interface Props {
  title: string;
  description: string;
  headline: string;
  intro: string;
  legacyNote?: string;
}

const { title, description, headline, intro, legacyNote } = Astro.props;

function readJsonGz(relativePath: string): unknown | null {
  try {
    return JSON.parse(
      gunzipSync(readFileSync(resolve(relativePath))).toString("utf-8"),
    );
  } catch (error) {
    console.error(`Failed to read ${relativePath}:`, error);
    return null;
  }
}

const spatial = readJsonGz(
  "public/data/analytics/spatial_analysis.json.gz",
) as { metadata?: { generated_at?: unknown } } | null;

const archiveGeneratedAt =
  typeof spatial?.metadata?.generated_at === "string"
    ? spatial.metadata.generated_at
    : null;

const archiveDate =
  archiveGeneratedAt === null
    ? "generation date not supplied"
    : new Date(archiveGeneratedAt).toLocaleDateString("en-GB", {
        day: "numeric",
        month: "short",
        year: "numeric",
        timeZone: "UTC",
      });

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const researchLinks = [
  { href: `${base}/analytics/`, label: "Studies" },
  { href: `${base}/research/trends`, label: "Trends" },
  { href: `${base}/research/segments`, label: "Segments" },
  { href: `${base}/research/tools`, label: "Tools" },
  { href: `${base}/research/map`, label: "Research map" },
];

const baseUrl = import.meta.env.BASE_URL;
---

<Layout title={title} description={description}>
  <Sidebar currentPath={Astro.url.pathname} />

  <main id="main-content" tabindex="-1" class="flex-1 pt-14 lg:pt-0 ml-0 lg:ml-64 transition-all duration-300">
    <div class="mx-auto w-full max-w-[1320px] px-4 py-8 sm:px-8">
      <header class="max-w-3xl">
        <p class="text-xs font-bold uppercase tracking-[1.6px] text-[hsl(var(--rust))]">
          Research / Map / Archive
        </p>
        <h1 class="mt-3 text-4xl font-bold text-foreground sm:text-5xl">{headline}</h1>
        <p class="mt-4 text-lg text-muted-foreground">{intro}</p>
        <p class="mt-4 inline-block rounded-sm bg-[hsl(var(--secondary))] px-2 py-1 text-xs font-bold text-foreground">
          Archive · {archiveDate} · not validated for current use
        </p>
        <nav aria-label="Research destinations" class="mt-4 flex flex-wrap gap-3 text-sm">
          {researchLinks.map((link) => (
            <a
              href={link.href}
              class="rounded border border-border bg-card px-3 py-1.5 font-bold text-foreground hover:bg-muted/40"
            >
              {link.label}
            </a>
          ))}
        </nav>
      </header>

      {
        legacyNote && (
          <p class="mt-4 max-w-3xl rounded-lg border border-border bg-muted/20 px-4 py-3 text-sm text-muted-foreground">
            {legacyNote}
          </p>
        )
      }

      <noscript>
        <div class="mt-6 rounded-lg border border-border bg-card p-5 text-sm text-foreground">
          <p class="font-bold">This workspace needs JavaScript.</p>
          <p class="mt-2 text-muted-foreground">
            The map draws planning-area geometry from
            <code class="font-mono">planning_areas.geojson</code> and reads
            observed transaction metrics from
            <code class="font-mono">map_metrics.json.gz</code> in the browser.
            The nine archived research layers come from
            <code class="font-mono">analytics/spatial_analysis.json.gz</code>,
            <code class="font-mono">analytics/feature_impact.json.gz</code> and
            <code class="font-mono">analytics/predictive_analytics.json.gz</code>.
            None of the three is current model evidence, and none is shaded onto
            the map. The observed comparison at
            <code class="font-mono">{baseUrl}explore</code> offers the same 2025
            transaction values without this workspace.
          </p>
        </div>
      </noscript>

      <div class="mt-6">
        <PriceMap
          client:only="react"
          baseUrl={baseUrl}
          geoJsonUrl={`${baseUrl}data/planning_areas.geojson`}
          metricsUrl={`${baseUrl}data/map_metrics.json.gz`}
        />
      </div>

      <footer class="mt-8 border-t border-border pt-4 text-xs text-muted-foreground">
        <p>
          Observed fill: <code class="font-mono">map_metrics.json.gz</code> — transaction medians
          and counts, not a valuation. Archive inspection: the three
          <code class="font-mono">analytics/*</code> extracts, generated {archiveDate}. Their
          extraction date is not an observation period.
        </p>
        <p class="mt-1">
          Retained layer IDs: nine (spatial, feature, predictive). Historical forecast targets are
          labelled as archived, and no layer is presented as a current signal.
        </p>
      </footer>
    </div>
  </main>
</Layout>
