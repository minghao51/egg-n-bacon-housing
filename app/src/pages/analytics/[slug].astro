---
import Layout from '@/layouts/Layout.astro';
import Sidebar from '@/components/Sidebar.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import InlineChartRenderer from '@/components/charts/InlineChartRenderer';
import { studyEvidence } from '@/components/studies/lib/studies';
import { getCollection, render } from 'astro:content';

// Generate static paths for all analytics docs
export async function getStaticPaths() {
  const docs = await getCollection('analytics');
  return docs.map((doc) => ({
    params: { slug: doc.id.replace(/\.md$/, '') },
    props: { doc },
  }));
}

const { doc } = Astro.props;
const { Content, headings } = await render(doc);

const title = doc.data.title || 'Untitled';
const status = doc.data.status;
const date = doc.data.date;
const slug = doc.id.replace(/\.mdx?$/, '');
const evidence = studyEvidence(slug);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Format headings for TOC. The study's leading H1 is stripped by the remark
// plugin (the shell owns the page H1), so a level-1 entry never appears here.
const tocHeadings = headings
  .filter((h) => h.depth > 1)
  .map((h) => ({
    id: h.slug,
    text: h.text,
    level: h.depth,
  }));

const publishedDate =
  date instanceof Date
    ? date.toLocaleDateString('en-GB', {
        day: 'numeric',
        month: 'short',
        year: 'numeric',
        timeZone: 'UTC',
      })
    : null;
---

<Layout title={`${title} - Analytics`}>
  <Sidebar currentPath={Astro.url.pathname} />
  <TableOfContents headings={tocHeadings} />

  <main id="main-content" tabindex="-1" class="flex-1 pt-14 lg:pt-0 ml-0 lg:ml-64 mr-0 xl:mr-64">
    <div class="max-w-4xl mx-auto px-4 sm:px-8 py-12">
      <!-- Breadcrumb -->
      <nav class="mb-4">
        <ol class="flex items-center space-x-2 text-sm">
          <li>
            <a
              href={`${import.meta.env.BASE_URL}analytics/`}
              class="text-muted-foreground hover:text-foreground"
            >
              Analytics
            </a>
          </li>
          <li class="text-muted-foreground">/</li>
          <li class="text-foreground font-medium">{title}</li>
        </ol>
      </nav>

      <!-- Header -->
      <header class="mb-8">
        <div class="flex items-center gap-3 mb-3">
          <h1 class="text-4xl font-bold text-foreground">{title}</h1>
          {status && (
            <span class="px-3 py-1 text-xs font-semibold rounded-full bg-primary/10 text-primary">
              {status}
            </span>
          )}
        </div>
        <p class="mt-2 flex flex-wrap gap-x-3 gap-y-1 text-sm text-muted-foreground">
          {publishedDate && <span>Published {publishedDate}</span>}
          {doc.data.readingTime && <span>· {doc.data.readingTime}</span>}
          {doc.data.technicalLevel && <span>· {doc.data.technicalLevel}</span>}
          {doc.data.category && <span>· {doc.data.category}</span>}
        </p>
      </header>

      <section
        aria-label="Evidence status"
        class="mb-8 rounded-xl border border-border bg-muted/20 p-4 text-sm"
      >
        <p class="font-bold text-foreground">
          {evidence.unitReview
            ? 'Unit review required'
            : 'Published research — read the period and units with the finding'}
        </p>
        <p class="mt-2 text-muted-foreground">{evidence.note}</p>
        {evidence.chartsWithheld && (
          <p class="mt-2 text-muted-foreground">
            Charts are withheld on this study. The source tables remain below,
            unchanged, so the published values are still readable.
          </p>
        )}
      </section>

      <!-- Markdown Content -->
      <article class="prose prose-slate max-w-none dark:prose-invert mb-8" id="article-content">
        <Content />
      </article>

      <style>
        /* Custom styling for rendered content */
        .prose table {
          @apply w-full border-collapse my-6;
        }
        .prose th,
        .prose td {
          @apply border border-border px-4 py-2 text-left;
        }
        .prose th {
          @apply bg-muted font-semibold text-foreground;
        }
        .prose tr:hover {
          @apply bg-muted/50;
        }

        .prose [data-chart-metadata='true'] {
          display: none;
        }

        /* KaTeX Styling adjustments */
        .katex-display {
          @apply overflow-x-auto py-4;
        }
      </style>

      <!-- Inline Charts (scans DOM for opt-in markers only). Withheld on a
           study whose units are under review: a marker must never redraw a
           mislabelled table as a chart. -->
      {!evidence.chartsWithheld && <InlineChartRenderer client:only="react" />}

      <!-- Footer Navigation -->
      <nav class="mt-12 flex flex-wrap items-center gap-4 border-t border-border pt-8">
        <a
          class="rounded border border-border px-3 py-2 text-sm font-bold text-foreground hover:bg-muted/40"
          href={`${base}/explore`}
        >
          Explore observed HDB →
        </a>
        <a
          class="rounded border border-border px-3 py-2 text-sm font-bold text-foreground hover:bg-muted/40"
          href={`${base}/catalog/`}
        >
          Open the data catalog
        </a>
        <a
          href={`${import.meta.env.BASE_URL}analytics/`}
          class="inline-flex items-center text-sm text-muted-foreground hover:text-foreground transition-colors"
        >
          <svg
            class="w-4 h-4 mr-2"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width={2}
              d="M10 19l-7-7m0 0l7-7m-7 7h18"
            />
          </svg>
          Back to Analytics Overview
        </a>
      </nav>
    </div>
  </main>
</Layout>
