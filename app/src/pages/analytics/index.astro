---
import Layout from '@/layouts/Layout.astro';
import Sidebar from '@/components/Sidebar.astro';
import StudiesLibrary from '@/components/studies/StudiesLibrary';
import { getCollection } from 'astro:content';
import {
  STUDY_CATEGORIES,
  studyEvidence,
  type StudyCardData,
  type StudyCategory,
} from '@/components/studies/lib/studies';

const allDocs = await getCollection('analytics');

const studies: StudyCardData[] = allDocs
  .map((doc) => {
    const slug = doc.id.replace(/\.mdx?$/, '');
    const evidence = studyEvidence(slug);
    const date =
      doc.data.date instanceof Date
        ? doc.data.date.toISOString().slice(0, 10)
        : null;

    return {
      slug,
      title: doc.data.title || doc.id,
      description: doc.data.description || '',
      category: (doc.data.category || 'technical-reports') as StudyCategory,
      date,
      readingTime: doc.data.readingTime ?? null,
      technicalLevel: doc.data.technicalLevel ?? null,
      personas: doc.data.personas ?? [],
      evidenceReview: evidence.unitReview,
    } satisfies StudyCardData;
  })
  .sort((a, b) => {
    if (a.date === b.date) return a.title.localeCompare(b.title);
    if (a.date === null) return 1;
    if (b.date === null) return -1;
    return b.date.localeCompare(a.date);
  });

const categoriesPresent = STUDY_CATEGORIES.filter((category) =>
  studies.some((study) => study.category === category),
);
const reviewed = studies.filter((study) => study.evidenceReview);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const researchLinks = [
  { href: `${base}/analytics/`, label: 'Studies' },
  { href: `${base}/research/trends`, label: 'Trends' },
  { href: `${base}/research/segments`, label: 'Segments' },
  { href: `${base}/research/tools`, label: 'Tools' },
  { href: `${base}/research/map`, label: 'Research map' },
];
---

<Layout title="Studies - Singapore Housing Research">
  <Sidebar currentPath={Astro.url.pathname} />

  <main id="main-content" tabindex="-1" class="flex-1 pt-14 lg:pt-0 ml-0 lg:ml-64">
    <div class="mx-auto w-full max-w-[1320px] px-4 py-12 sm:px-8">
      <header class="mb-8 max-w-3xl">
        <p class="text-xs font-bold uppercase tracking-[1.6px] text-[hsl(var(--rust))]">
          Research / Studies
        </p>
        <h1 class="mt-3 text-4xl font-bold text-foreground sm:text-5xl">
          Stories with a visible evidence trail.
        </h1>
        <p class="mt-4 text-lg text-muted-foreground">
          Published research from the archived analysis series. Each study keeps
          its own observation period, units and limitations; none of them is a
          current transaction median or an individual-flat valuation.
        </p>
        <nav aria-label="Research destinations" class="mt-4 flex flex-wrap gap-3 text-sm">
          {researchLinks.map((link) => (
            <a
              href={link.href}
              class="rounded border border-border bg-card px-3 py-1.5 font-bold text-foreground hover:bg-muted/40"
            >
              {link.label}
            </a>
          ))}
        </nav>
      </header>

      <!-- Persona entry points -->
      <section class="mb-10">
        <h2 class="text-xl font-semibold text-foreground mb-4">
          Find insights for your situation
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <a
            href={`${import.meta.env.BASE_URL}analytics/personas/first-time-buyer`}
            class="bg-green-50 dark:bg-green-950 border border-green-200 dark:border-green-800 rounded-lg p-6 hover:bg-green-100 dark:hover:bg-green-900 transition-colors"
          >
            <div class="flex items-center gap-3 mb-2">
              <span class="text-3xl">🏠</span>
              <h3 class="font-semibold text-green-700 dark:text-green-300">
                First-Time Buyer
              </h3>
            </div>
            <p class="text-sm text-green-600 dark:text-green-400">
              Affordability, lease decay, location value
            </p>
          </a>

          <a
            href={`${import.meta.env.BASE_URL}analytics/personas/investor`}
            class="bg-blue-50 dark:bg-blue-950 border border-blue-200 dark:border-blue-800 rounded-lg p-6 hover:bg-blue-100 dark:hover:bg-blue-900 transition-colors"
          >
            <div class="flex items-center gap-3 mb-2">
              <span class="text-3xl">💼</span>
              <h3 class="font-semibold text-blue-700 dark:text-blue-300">
                Property Investor
              </h3>
            </div>
            <p class="text-sm text-blue-600 dark:text-blue-400">
              Price appreciation, rental yields, market timing
            </p>
          </a>

          <a
            href={`${import.meta.env.BASE_URL}analytics/personas/upgrader`}
            class="bg-orange-50 dark:bg-orange-950 border border-orange-200 dark:border-orange-800 rounded-lg p-6 hover:bg-orange-100 dark:hover:bg-orange-900 transition-colors"
          >
            <div class="flex items-center gap-3 mb-2">
              <span class="text-3xl">⬆️</span>
              <h3 class="font-semibold text-orange-700 dark:text-orange-300">
                Upsizer / Upgrader
              </h3>
            </div>
            <p class="text-sm text-orange-600 dark:text-orange-400">
              Maximizing sale price, finding upgrade value
            </p>
          </a>
        </div>
      </section>

      <!-- Published-study counts, all derived from the collection -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-10">
        <div class="bg-card border border-border rounded-lg p-6">
          <div class="text-sm font-medium text-muted-foreground mb-1">
            Published studies
          </div>
          <div class="text-3xl font-bold text-foreground">{studies.length}</div>
        </div>
        <div class="bg-card border border-border rounded-lg p-6">
          <div class="text-sm font-medium text-muted-foreground mb-1">
            Topics
          </div>
          <div class="text-3xl font-bold text-foreground">{categoriesPresent.length}</div>
        </div>
        <div class="bg-card border border-border rounded-lg p-6">
          <div class="text-sm font-medium text-muted-foreground mb-1">
            Under unit review
          </div>
          <div class="text-3xl font-bold text-foreground">{reviewed.length}</div>
          <p class="mt-1 text-xs text-muted-foreground">
            {reviewed.length === 0
              ? 'No study currently withholds a chart.'
              : reviewed.map((study) => study.title).join(', ')}
          </p>
        </div>
      </div>

      <StudiesLibrary client:load studies={studies} baseUrl={import.meta.env.BASE_URL} />

      <noscript>
        <section class="mt-8">
          <h2 class="text-xl font-semibold text-foreground">All published studies</h2>
          <p class="mt-2 text-sm text-muted-foreground">
            Search, topic and audience filters need JavaScript. Every study is
            listed here without them.
          </p>
          <ul class="mt-4 space-y-2">
            {studies.map((study) => (
              <li>
                <a
                  href={`${import.meta.env.BASE_URL}analytics/${study.slug}`}
                  class="font-bold text-foreground underline"
                >
                  {study.title}
                </a>
                <span class="text-sm text-muted-foreground"> — {study.description}</span>
              </li>
            ))}
          </ul>
        </section>
      </noscript>
    </div>
  </main>
</Layout>
