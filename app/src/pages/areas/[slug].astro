---
/**
 * `/areas/[slug]` — static area fieldnote (slice S6).
 *
 * One page per planning area, rendered at build time from the published assets
 * through `src/utils/area-page.ts`. Every published number, availability state
 * and the withheld-baseline notice are in the build-time HTML; the two panels
 * below (`AreaSectionPanel`, `AreaHistoryPanel`) are the page's only client
 * islands, mounted for interaction on already-rendered content.
 *
 * The only browser code is the inline return-link enhancer below. A static
 * build cannot read the incoming query string, so a JS-disabled reader gets the
 * documented `/explore` fallback while everyone else gets the same validated
 * explorer query back. It copies allow-listed query keys only — never an
 * arbitrary URL.
 */
import Layout from "@/layouts/Layout.astro";
import Sidebar from "@/components/Sidebar.astro";
import AreaSectionPanel from "@/components/areas/AreaSectionPanel";
import AreaHistoryPanel from "@/components/areas/AreaHistoryPanel";
import {
  AREA_PAGE_COMBINATIONS,
  areaEraScope,
  areaPageDefaultOption,
  areaPageOptions,
  areaSectionScope,
  loadAreaPages,
  type AreaPageData,
  type AreaPageSection,
} from "@/utils/area-page";
import { ACTIVITY_SALE_FLOOR, type AreaActivityRow } from "@/utils/area-activity";
import type {
  ObservedMetric,
  ObservedObservation,
} from "@/utils/observed-data";
import { fileURLToPath } from "node:url";

export async function getStaticPaths() {
  // `astro build` runs from `app/`, and this file lives at
  // `app/src/pages/areas/[slug].astro`, so three levels up is the app root.
  const rootDir = fileURLToPath(new URL("../../../", import.meta.url));
  const areas = await loadAreaPages(rootDir);
  return areas.map((area) => ({
    params: { slug: area.slug },
    props: { area },
  }));
}

interface Props {
  area: AreaPageData;
}

const { area } = Astro.props;

/** Deployment base without its trailing slash ("" at the root path). */
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const exploreHref = `${base}/explore`;

const sectionOptions = areaPageOptions(area);
const defaultSection = areaPageDefaultOption(sectionOptions);
const defaultSectionId = defaultSection.id;

const primary =
  area.sections.find(
    (section) => section.section === defaultSectionId,
  ) ?? null;

const primarySectionName = primary?.section ?? "year_2025_hdb";

function metricValue(
  observations: ObservedObservation[] | null | undefined,
  metric: ObservedMetric,
): number | null {
  if (observations === null || observations === undefined) return null;
  const found = observations.find((entry) => entry.metric === metric);
  return found === undefined ? null : found.value;
}

function areaMetric(
  section: AreaPageSection | null,
  metric: ObservedMetric,
): number | null {
  return metricValue(section?.area?.metrics, metric);
}

function formatCount(value: number | null): string {
  return value === null
    ? "Not published"
    : Math.round(value).toLocaleString("en-US");
}

function formatPrice(value: number | null): string {
  return value === null
    ? "Not published"
    : `S$${Math.round(value).toLocaleString("en-US")}`;
}

function formatPsf(value: number | null): string {
  return value === null
    ? "Not published"
    : `S$${Math.round(value).toLocaleString("en-US")} psf`;
}

// The default section's count anchors the page subtitle; the panel owns the
// per-metric values for whatever section the reader selects.
const areaVolume = areaMetric(primary, "volume");

const kicker = `Area fieldnote / ${area.areaName}`;
// The headline scope must describe the section that was actually read: an area
// published only in a wider window is anchored on that window, not on 2025.
const headlineScope = primary
  ? areaSectionScope(primary.era, primary.property)
  : "Not published";
const scopeSentence = primary ? areaEraScope(primary.era) : "the published data";
const subtitle =
  areaVolume === null
    ? `${headlineScope} · no transactions published in ${primarySectionName}`
    : `${headlineScope} · ${formatCount(areaVolume)} observed transactions`;

const availabilityRows = AREA_PAGE_COMBINATIONS.map((combination) => {
  const section =
    area.sections.find(
      (entry) =>
        entry.era === combination.era &&
        entry.property === combination.property,
    ) ?? null;
  return {
    label: combination.label,
    sectionName: section?.section ?? "not published",
    href: `?property=${combination.property}&period=${combination.era}`,
    price: areaMetric(section, "median_price"),
    psf: areaMetric(section, "median_psf"),
    volume: areaMetric(section, "volume"),
  };
});

const generationShort =
  area.generation === null ? null : area.generation.slice(0, 12);

/**
 * Activity cells (RF10).
 *
 * `null` never renders as a zero: a verified `no-sales` window and a missing
 * observation say different things, so the caller picks the wording from the
 * window's status rather than from the number alone.
 */
function activityCount(value: number | null): string {
  return value === null ? "No observed sales" : value.toLocaleString("en-US");
}

function activityChange(row: AreaActivityRow): string {
  const change = row.changePercent;
  const before = row.priorYear?.transactionCount ?? null;
  const now = row.current.transactionCount;
  if (change === null || before === null || now === null) {
    return row.changeUnavailableReason ?? "Not computable";
  }
  const absolute = now - before;
  const sign = change >= 0 ? "+" : "−";
  return `${sign}${Math.abs(absolute).toLocaleString("en-US")} sales (${sign}${Math.abs(change).toFixed(1)}%)`;
}
---

<Layout
  title={`${area.areaName} — Area fieldnote - Egg n Bacon Housing`}
  description={`Observed resale transaction prices and counts published for ${area.areaName}. A record of what sold, not a valuation or a prediction.`}
>
  <Sidebar currentPath={Astro.url.pathname} />

  <main
    id="main-content"
    tabindex="-1"
    class="flex-1 pt-14 ml-0 lg:ml-64 transition-all duration-300"
  >
    <div class="mx-auto w-full max-w-[1320px] px-4 py-8 sm:px-8">
      <a
        id="area-return"
        href={exploreHref}
        data-explore-href={exploreHref}
        class="text-sm font-bold text-[hsl(var(--teal))] underline-offset-4 hover:underline"
      >
        <span aria-hidden="true">← </span>Back to Explore
      </a>

      <header class="mt-6">
        <p
          class="text-xs font-bold uppercase tracking-[1.6px] text-[hsl(var(--rust))]"
        >
          {kicker}
        </p>
        <h1 class="mt-3 text-4xl font-bold text-foreground sm:text-5xl">
          {area.areaName}
        </h1>
        <p class="mt-3 text-lg text-muted-foreground">{subtitle}</p>
        <p class="mt-2 text-sm text-muted-foreground">
          Section <code class="font-mono">map_metrics.{primarySectionName}</code>
        </p>
      </header>

      <hr class="mt-6 border-border" />

      <noscript>
        <p class="mt-6 rounded-lg border border-border bg-muted px-4 py-3 text-sm text-foreground">
          <span class="font-bold">Fixed build-time scope.</span> Without
          JavaScript this page shows {headlineScope} from{" "}
          <code class="font-mono">map_metrics.{primarySectionName}</code>. A
          property type or period in the address bar cannot change these static
          figures; follow one of the section links under “What else is
          published”, or open Explore.
        </p>
      </noscript>

      <div class="mt-8 grid gap-8 lg:grid-cols-[minmax(0,1fr)_20rem]">
        <AreaSectionPanel
          client:load
          areaName={area.areaName}
          areaId={area.areaId}
          options={sectionOptions}
          defaultOptionId={defaultSectionId}
          baseline={{ compatible: area.baselineCompatible, status: area.baselineStatus }}
          base={base}
        />

        <aside
          aria-labelledby="area-limits-heading"
          class="min-w-0 rounded-lg bg-[hsl(var(--accent))] p-5"
        >
          <h2
            id="area-limits-heading"
            class="text-xs font-bold uppercase tracking-[1.6px] text-[hsl(var(--teal))]"
          >
            What this doesn’t say
          </h2>
          <p class="mt-3 text-xl font-bold text-foreground">
            Not a valuation of an individual flat.
          </p>
          <ul class="mt-4 space-y-3 text-sm text-foreground">
            <li>
              No flat-type, floor, lease or size filters are available in this
              aggregate view — the median pools every home sold in the area.
            </li>
            <li>No confidence interval is published in this asset.</li>
            <li>
              Counts describe included records, not complete market capture, and
              nothing here is a live listing or asking price.
            </li>
          </ul>
        </aside>
      </div>

      <hr class="mt-10 border-border" />

      {
        area.activity !== null && (
          <section
            aria-labelledby="area-activity-heading"
            class="mt-8 min-w-0"
            data-area-activity={area.activity.rows.length > 0 ? 'published' : 'none'}
          >
            <h2
              id="area-activity-heading"
              class="text-2xl font-bold text-foreground"
            >
              Observed transaction activity
            </h2>
            <p class="mt-2 text-sm text-muted-foreground">
              Rolling quarter <strong>{area.activity.range}</strong> — three
              months of observed resale transactions ending at the{' '}
              {area.activity.cutoffMonth} cutoff
              {area.activity.comparatorRange !== null ? (
                <>
                  , compared with the same quarter a year earlier (
                  {area.activity.comparatorRange})
                </>
              ) : (
                <>; this quarter publishes no prior-year comparator</>
              )}
              . The trailing twelve months is shown separately as context and is
              never folded into the quarter.
            </p>

            {area.activity.rows.length === 0 ? (
              <p class="mt-4 rounded-lg border border-border bg-muted px-4 py-3 text-sm text-foreground">
                No rolling-quarter observation is published for{' '}
                {area.areaName}. Nothing is shown rather than a zero.
              </p>
            ) : (
              <div class="mt-4 overflow-x-auto">
                <table
                  class="w-full min-w-[46rem] border-collapse text-sm"
                  data-activity-table
                >
                  <caption class="sr-only">
                    Observed rolling-quarter resale transactions by property type
                    for {area.areaName}
                  </caption>
                  <thead>
                    <tr class="border-b border-border text-left">
                      <th scope="col" class="py-2 pr-4 font-bold">
                        Property type
                      </th>
                      <th scope="col" class="py-2 pr-4 font-bold">
                        Observed sales, {area.activity.range}
                      </th>
                      <th scope="col" class="py-2 pr-4 font-bold">
                        Observed sales, prior-year quarter
                      </th>
                      <th scope="col" class="py-2 pr-4 font-bold">
                        Change in observed sales
                      </th>
                      <th scope="col" class="py-2 pr-4 font-bold">
                        Twelve months to {area.activity.cutoffMonth}
                      </th>
                      <th scope="col" class="py-2 font-bold">
                        Meets the {ACTIVITY_SALE_FLOOR}-sale floor in both
                        quarters
                      </th>
                    </tr>
                  </thead>
                  <tbody>
                    {area.activity.rows.map((row) => (
                      <tr
                        class="border-b border-border align-top"
                        data-activity-row={row.propertyType}
                        data-activity-eligible={
                          row.eligible ? 'true' : 'false'
                        }
                      >
                        <th scope="row" class="py-3 pr-4 text-left font-bold">
                          {row.propertyLabel}
                        </th>
                        <td class="py-3 pr-4" data-numeric>
                          {activityCount(row.current.transactionCount)}
                          {row.current.status === 'no-sales' && (
                            <span class="mt-1 block text-xs text-muted-foreground">
                              verified zero for this population
                            </span>
                          )}
                        </td>
                        <td class="py-3 pr-4" data-numeric>
                          {row.priorYear === null
                            ? 'Not published'
                            : activityCount(row.priorYear.transactionCount)}
                        </td>
                        <td class="py-3 pr-4" data-numeric>
                          {activityChange(row)}
                        </td>
                        <td class="py-3 pr-4" data-numeric>
                          {row.ttmCount === null
                            ? 'Not published'
                            : activityCount(row.ttmCount)}
                        </td>
                        <td class="py-3">
                          {row.eligible ? (
                            <span>Yes</span>
                          ) : (
                            <span>
                              No — <span>{row.ineligibleReason}</span>
                            </span>
                          )}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}

            <ul class="mt-4 space-y-2 text-sm text-muted-foreground">
              {area.activity.notes.map((note) => (
                <li>{note}</li>
              ))}
            </ul>

            {area.activity.periodId !== null && (
              <p class="mt-3 text-sm">
                <a
                  href={`${base}/explore?period=${area.activity.periodId}`}
                  class="font-bold text-[hsl(var(--teal))] underline underline-offset-4 hover:no-underline"
                >
                  Open this quarter in Explore
                </a>
              </p>
            )}
          </section>
        )
      }

      {/*
        RF10 slice 2b: the monthly payload is the largest asset in the release,
        so it is fetched only when the reader asks. The island receives identity
        only — never history data in props.
      */}
      <AreaHistoryPanel
        client:idle
        areaName={area.areaName}
        areaId={area.areaId}
        property={defaultSection.property}
        base={base}
      />

      <section aria-labelledby="area-availability-heading" class="mt-8 min-w-0">
        <h2
          id="area-availability-heading"
          class="text-2xl font-bold text-foreground"
        >
          What else is published for {area.areaName}
        </h2>
        <p class="mt-2 text-sm text-muted-foreground">
          Four joint combinations are in scope for a fieldnote. A combination
          with no published block is not a zero and is not a flat price.
        </p>
        <ul class="mt-4 divide-y divide-border rounded-lg border border-border bg-card">
          {
            availabilityRows.map((row) => (
              <li class="flex flex-col gap-1 px-4 py-3 sm:flex-row sm:items-baseline sm:justify-between">
                <p class="text-base font-bold text-foreground">
                  <a
                    href={row.href}
                    class="underline-offset-4 hover:underline"
                  >
                    {row.label}
                  </a>
                  <span class="ml-2 font-mono text-xs font-normal text-muted-foreground">
                    {row.sectionName}
                  </span>
                </p>
                {row.price === null ? (
                  <p class="text-sm text-muted-foreground">
                    Not published — no transactions published in this joint section
                  </p>
                ) : (
                  <p class="text-sm text-foreground" data-numeric>
                    {formatPrice(row.price)} · {formatPsf(row.psf)} ·{" "}
                    {formatCount(row.volume)}
                  </p>
                )}
              </li>
            ))
          }
        </ul>
      </section>

      <section
        aria-labelledby="area-source-heading"
        class="mt-8 rounded-lg border border-border bg-card p-5"
      >
        <h2
          id="area-source-heading"
          class="text-xs font-bold uppercase tracking-[1.6px] text-[hsl(var(--rust))]"
        >
          Source &amp; method
        </h2>
        <ul class="mt-3 space-y-2 break-words text-sm text-foreground">
          <li>
            Area: <code class="font-mono">map_metrics.{primarySectionName}.</code>
            {area.areaId} · National:{" "}
            <code class="font-mono">
              dashboard_overview.stats.{primarySectionName}
            </code>.
          </li>
          <li>
            Both are medians of observed nominal transaction prices for{" "}
            {scopeSentence}. No property-only or period-only block is
            substituted for a missing joint section.
          </li>
          <li>
            Transaction-price median and PSF median are computed independently
            from different distributions; do not divide one by the other.
          </li>
          {
            area.baselineCompatible && generationShort !== null ? (
              <li>
                Publication generation verified at build time:{" "}
                <code class="font-mono">{generationShort}</code>.
              </li>
            ) : (
              <li>
                Publication generation not verified, so no cross-asset national
                comparison is shown.
              </li>
            )
          }
        </ul>
      </section>
    </div>
  </main>

</Layout>
