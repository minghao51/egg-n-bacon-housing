---
/**
 * `/dashboard` — the compatibility address for the Overview.
 *
 * The Overview destination is the site root, so this URL renders the same
 * surface with a canonical link pointing at `/` and one honest line saying what
 * it is. It stays a real, rendered page rather than a meta-refresh or redirect:
 * several suites navigate here and assert the headings, and a redirect page
 * would carry no content and no internal links.
 */
import OverviewSurface from '@/components/overview/OverviewSurface.astro';

// Absolute, and derived from the same `site` + `base` pair the build uses, so
// the canonical is correct under `/` and under `/egg-n-bacon-housing/` alike.
const canonical = new URL(import.meta.env.BASE_URL, Astro.site ?? Astro.url).href;
const rootHref = import.meta.env.BASE_URL;
---

<OverviewSurface
  title="Dashboard overview - Egg n Bacon Housing"
  description="Compatibility address for the Overview: 2025 median prices and transaction counts by property type, the definitions behind a median, and where to compare areas, trends and decision tools."
  canonical={canonical}
  compatNote={`Compatibility address for the Overview: this URL keeps working and renders the same figures as the site root, which is the canonical address. Every link below works from here unchanged.`}
  compatHref={rootHref}
/>
