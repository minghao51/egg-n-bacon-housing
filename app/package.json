{
  "name": "egg-n-bacon-analytics",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "engines": {
    "bun": "1.2.23"
  },
  "scripts": {
    "dev": "ASTRO_DEV_BACKGROUND=0 astro dev",
    "sync-catalog": "bun scripts/sync-catalog.mjs",
    "validate-data": "bun scripts/validate-data.mjs",
    "measure:payload": "node scripts/measure-payload.mjs",
    "build": "PUBLIC_OBSERVED_RELEASE=v2 bun run build:base",
    "build:base": "bun run validate-data && bun run sync-catalog && astro build",
    "build:legacy": "PUBLIC_OBSERVED_RELEASE=legacy bun run build:base",
    "build:pages": "ASTRO_PAGES=true bun run build",
    "preview": "ASTRO_PREVIEW_BACKGROUND=0 astro preview",
    "serve:pages": "node scripts/serve-pages-base.mjs",
    "astro": "astro",
    "test:e2e": "playwright test",
    "test:unit": "bun test tests/unit",
    "test:e2e:prod": "bun run build && PLAYWRIGHT_SERVER_COMMAND='bun run preview -- --host 127.0.0.1' PLAYWRIGHT_BASE_URL='http://127.0.0.1:4321' playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-remark": "^7.3.10",
    "@astrojs/react": "^7.1.9",
    "@tailwindcss/postcss": "^4.3.5",
    "@tanstack/react-table": "^8.21.3",
    "@types/leaflet": "^1.9.22",
    "@xyflow/react": "^12.12.1",
    "astro": "^7.4.13",
    "autoprefixer": "^10.7.0",
    "clsx": "^2.1.1",
    "dompurify": "^3.5.0",
    "katex": "^0.16.47",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.575.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.11.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^3.23.0",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^3.4.19"
  }
}
