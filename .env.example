ONEMAP_EMAIL=
ONEMAP_EMAIL_PASSWORD=
ONEMAP_TOKEN=
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_key
R2_SECRET_ACCESS_KEY=your_secret
R2_BUCKET=egg-bacon-housing-data
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# URA Data Service API (https://eservice.ura.gov.sg/maps/api/reg.html — free registration, key sent by email).
# Optional: powers live private-residential (condo) transaction fetch; absent = falls back to manual R2 CSVs.
URA_API_ACCESS_KEY=

# Quarantine retention (days) for run-specific validation rejects.
PIPELINE__QUARANTINE_RETENTION_DAYS=90

# Large-table validation policy for the ~1M-row gold/platinum pydantic
# boundaries (transactions_enriched, unified_dataset). "sample" (default) =
# 100%-coverage vectorized constraint pre-check + a 10k-row pydantic
# spot-check; "full" validates every row; "fail" validates every row and
# raises on any invalid row. Use "full" or "fail" for cold runs and CI.
PIPELINE__LARGE_TABLE_VALIDATION_POLICY=sample

# Optional Hamilton tracking. All identity fields are required when enabled.
TRACKING_ENABLED=false
TRACKING_PROJECT_ID=
TRACKING_USERNAME=
TRACKING_ENVIRONMENT=
